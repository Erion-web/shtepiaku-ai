# Copy to .env and fill in. Never commit real secrets.

# Staff dashboard password. Required to enable /staff. No default is provided.
STAFF_PASSWORD=

# Secret used to sign staff session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: enables AI-written plan explanations. Without it the app uses the
# deterministic explanation and everything else keeps working.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# "demo" (default) uses the DEMO pricing configuration and stores leads in the
# demo table. "live" requires an approved tariff configuration (see
# shared/pricing/registry.ts); until one exists, public estimates are disabled.
PRICING_MODE=demo

# Lead storage. Leave empty locally to use a SQLite file in DATA_DIR.
# Required on Vercel. Use the service_role key (server-only, never in the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=8787
DATA_DIR=./data
